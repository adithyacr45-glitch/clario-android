<resources>
    <style name="Theme.Clario" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:navigationBarColor">#0B0D12</item>
        <item name="android:statusBarColor">#0B0D12</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowNoTitle">true</item>
    </style>
    <style name="Theme.Clario.Starting" parent="Theme.Clario">
        <item name="android:windowSplashScreenBackground">#0B0D12</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_clario_logo</item>
    </style>
</resources>
